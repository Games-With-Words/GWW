<?xml version="1.0" encoding="UTF-8"?>
<!--
  A FALLBACK, not the live sitemap.

  In production the server GENERATES /sitemap.xml, because the blog's URL set
  changes as posts publish and a hand-edited sitemap goes stale the first time
  nobody remembers to edit it. That route sits above the static handler, so this
  file is what remains for anyone hosting the client bundle on its own.

  Room URLs are deliberately absent either way — they are token-bearing and
  expire in four hours.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://games-with-words.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
